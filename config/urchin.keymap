#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        comma_semi: comma_semi_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_colon: dot_colon_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------
            // |  B  |  L  |  D  |  C  |  V  |   |  J  |  F  |  O  |  U  | RET |
            // |  N  |  R  |  T  |  S  |  G  |   |  Y  |  H  |  A  |  E  |  I  |
            // |  X  |  Q  |  M  |  W  |  Z  |   |  K  |  P  | ,/; | ./: |  /  |
            //                   | SYM | NAV |   | ESC | SPC |

            bindings = <
&kp B  &kp L  &kp D  &kp C  &kp V    &kp J  &kp F  &kp O        &kp U       &kp RET
&kp N  &kp R  &kp T  &kp S  &kp G    &kp Y  &kp H  &kp A        &kp E       &kp I
&kp X  &kp Q  &kp M  &kp W  &kp Z    &kp K  &kp P  &comma_semi  &dot_colon  &kp SLASH
                     &sl 1  &mo 2    &kp ESCAPE  &kp SPACE
            >;
        };

        Symbols {
            // ---------------------------------------------------------
            // |  `   |  TAB  |  '   |  "   |     |   |     |  [  |  ]  | BSPC |  *  |
            // | sCTL | sALT  | sSFT | sGUI |     |   |     |  (  |  )  |  -   |  \  |
            // |      |       | SYM2 | NUM  |     |   |     |  {  |  }  |  _   |  $  |
            //                       |      |     |   |     |     |

            bindings = <
&kp GRAVE   &kp TAB        &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &trans    &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSPACE  &kp ASTRK
&skq LCTRL  &skq LEFT_ALT  &skq LEFT_SHIFT   &skq LEFT_GUI      &trans    &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS      &kp BACKSLASH
&none       &none          &sl 4             &sl 3              &trans    &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UNDER      &kp DOLLAR
                                             &trans             &trans    &trans  &trans
            >;
        };

        Nav {
            // ---------------------------------------------------------
            // | VOLDN | VOLUP | BRI- | BRI+ |     |   | LCLK | MDN | MUP | CAPS |      |
            // |       |       |      |      |     |   | LFT  | DWN | UP  | RGT  |      |
            // |       |       | MLFT | MRGT |     |   |      |     |     |      | BOOT |
            //                        |      |     |   |      |     |

            bindings = <
&kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans    &mkp LCLK  &mmv MOVE_DOWN  &mmv MOVE_UP  &caps_word  &trans
&trans             &trans           &trans                &trans                &trans    &kp LEFT   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT   &trans
&trans             &trans           &mmv MOVE_LEFT        &mmv MOVE_RIGHT       &trans    &trans     &trans          &trans        &trans      &bootloader
                                                          &trans                &trans    &trans     &trans
            >;
        };

        Number {
            // ---------------------------------------------------------
            // |     |     |     |     |     |   |     |  1  |  2  |  3  |     |
            // |     |     |     |     |     |   |     |  4  |  5  |  6  |  0  |
            // |     |     |     |     |     |   |     |  7  |  8  |  9  |     |
            //                   |     |     |   |     |     |

            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &kp N4  &kp N5  &kp N6  &kp N0
&trans  &trans  &trans  &trans  &trans    &trans  &kp N7  &kp N8  &kp N9  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        Symbols2 {
            // ---------------------------------------------------------
            // |     |     |     |     |     |   |     |  @  |  !  |  <  |  >  |
            // |     |     |     |     |     |   |     |  =  |  &  |  +  |  ~  |
            // |     |     |     |     |     |   |     |  #  |  %  |  ^  |  |  |
            //                   |     |     |   |     |     |

            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &kp AT     &kp EXCL     &kp LESS_THAN  &kp GREATER_THAN
&trans  &trans  &trans  &trans  &trans    &trans  &kp EQUAL  &kp AMPS     &kp PLUS       &kp TILDE
&trans  &trans  &trans  &trans  &trans    &trans  &kp POUND  &kp PERCENT  &kp CARET      &kp PIPE
                        &trans  &trans    &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
